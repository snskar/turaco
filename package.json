{
  "name": "turaco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && next build",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "lint:fix": "next lint --fix",
    "initiate": "next build && next start",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "prepare": "husky",
    "perf": "npm run build:analyze && npm run start"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@next/font": "^14.2.15",
    "@prisma/client": "^6.8.2",
    "@tailwindcss/cli": "^4.1.7",
    "@uidotdev/usehooks": "^2.4.1",
    "@vercel/blob": "^1.1.1",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.12.1",
    "nanoid": "^5.1.5",
    "next": "15.3.2",
    "pg": "^8.16.0",
    "postcss": "^8.5.3",
    "prisma": "^6.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dom-confetti": "^0.2.0",
    "react-swipeable": "^7.0.2",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.61"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.3.2",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "husky": "^9.0.11",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.1",
    "dotenv-cli": "^7.0.0",
    "tailwindcss": "^4.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
