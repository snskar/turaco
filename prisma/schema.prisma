// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HeartlinkRelation {
  COUPLE
  FATHER
  MOTHER
  SISTER
  BROTHER
  FRIEND
  OTHER
}

enum HeartlinkOccasion {
  BIRTHDAY
  NEW_YEAR
  DIWALI
  RAKSHA_BANDHAN
  CHRISTMAS
  VALENTINES
  ANNIVERSARY
  CONGRATULATIONS
  GET_WELL_SOON
  I_AM_SORRY
  I_LOVE_YOU
  OTHER
}

model Heartlink {
  id          String       @id @default(cuid())
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Sender and Recipient information
  senderName  String
  recipientName String
  occasion    HeartlinkOccasion @default(BIRTHDAY)
  relation    HeartlinkRelation @default(FRIEND)
  message     String?

  // Media and content
  photos      Photo[]
  spotifyTrack SpotifyTrack?
  
  // Interactive elements
  activities  Activity[]
  compliments Compliment[]
  scratchCard ScratchCard[]
}

model Photo {
  id          String    @id @default(cuid())
  publicId    String    @unique
  url         String
  thumbnailUrl String?
  format      String?
  bytes       Int?
  width       Int?
  height      Int?
  createdAt   DateTime  @default(now())
  
  heartlinkId String
  heartlink   Heartlink @relation(fields: [heartlinkId], references: [id], onDelete: Cascade)
}

model SpotifyTrack {
  id          String    @id @default(cuid())
  spotifyId   String
  type        String
  name        String
  artist      String?
  imageUrl    String?
  previewUrl  String?
  heartlinkId String    @unique
  heartlink   Heartlink @relation(fields: [heartlinkId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String    @id @default(cuid())
  content     String
  isCustom    Boolean   @default(false)
  heartlinkId String
  heartlink   Heartlink @relation(fields: [heartlinkId], references: [id], onDelete: Cascade)
}

model Compliment {
  id          String    @id @default(cuid())
  content     String
  isCustom    Boolean   @default(false)
  heartlinkId String
  heartlink   Heartlink @relation(fields: [heartlinkId], references: [id], onDelete: Cascade)
}

model ScratchCard {
  id          String    @id @default(cuid())
  content     String
  isCustom    Boolean   @default(false)
  heartlinkId String
  heartlink   Heartlink @relation(fields: [heartlinkId], references: [id], onDelete: Cascade)
} 